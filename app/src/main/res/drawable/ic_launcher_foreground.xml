<?xml version="1.0" encoding="utf-8"?>
<!-- ReelVault mark: a library spine beside a saved bookmark with a play cutout.
     Geometry stays inside the 66dp safe circle of the 108dp adaptive canvas (farthest corner 32.2dp
     from center), is optically centered, and uses rounded corners and caps in the SF Symbols manner.
     Editable source: design/reelvault-icon.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Bookmark with the play triangle cut out (even-odd). -->
    <path
        android:fillColor="#FFF7F6F2"
        android:fillType="evenOdd"
        android:pathData="M46,30H69A4,4 0,0 1,73 34V80L57.5,69.5L42,80V34A4,4 0,0 1,46 30Z M52,43V60L66,51.5Z" />
    <!-- Library spine. -->
    <path
        android:fillColor="#FFF7F6F2"
        android:pathData="M34,34A3,3 0,0 1,37 37V73A3,3 0,0 1,31 73V37A3,3 0,0 1,34 34Z" />
</vector>
