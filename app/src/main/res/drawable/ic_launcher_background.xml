<?xml version="1.0" encoding="utf-8"?>
<!-- Near-black tile with a gentle top-to-bottom tone, the way Apple's dark icons get depth
     without a visible gradient. Ends match the app's raised surface and ground colors. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#FF262625" />
                <item android:offset="1" android:color="#FF0B0B0A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
